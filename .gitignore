# Raw research datasets
data/raw/**
!data/raw/.gitkeep

# Generated / extracted datasets
data/interim/**
data/processed/**
!data/interim/.gitkeep
!data/processed/.gitkeep

# Large / disposable generated artifacts
artifacts/**
